# ==========================================
# Backend-mpesa Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==========================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Daraja (Safaricom M-Pesa API) ---
# Get these from https://developer.safaricom.co.ke -> My Apps
MPESA_ENV=sandbox
# sandbox or production
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret

# Paybill (shortcode) details
MPESA_SHORTCODE=174379
# For sandbox, 174379 is Safaricom's default test paybill (paired with the passkey below)
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_INITIATOR_PASSWORD=your_initiator_password

# --- Callback URLs ---
# This MUST be a public HTTPS URL. Use ngrok locally, or your Vercel deployment URL when hosted.
BASE_URL=https://your-ngrok-or-vercel-url.app
MPESA_VALIDATION_URL=/api/mpesa/c2b/validation
MPESA_CONFIRMATION_URL=/api/mpesa/c2b/confirmation
MPESA_STK_CALLBACK_URL=/api/mpesa/stk/callback

# --- Supabase (Database) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Simple API key to protect your own endpoints (optional but recommended) ---
APP_API_KEY=change_this_to_a_random_secret
